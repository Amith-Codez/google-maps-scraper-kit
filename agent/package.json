    "drizzle-orm": "^0.45.4",
    "imapflow": "^2.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.54.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "nodemailer": "^10.0.16",
    "pino": "^10.4.0",
