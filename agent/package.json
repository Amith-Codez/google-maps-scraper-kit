{
  "name": "pitchwala",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev\" \"PITCHWALA_PROC=worker tsx watch --include src/lib src/worker/index.ts\"",
