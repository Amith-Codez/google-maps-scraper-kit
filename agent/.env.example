# Pitchwala settings. Copy to .env.local and fill in. The app refuses to start if a required key is missing.

# Kit engine (google-maps-scraper), localhost only. Never expose it.
SCRAPER_BASE_URL=http://localhost:8080

# Model providers (OpenAI-compatible). Active provider + fallback are chosen in Settings.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Gmail: your address + a 16-letter app password (myaccount.google.com/apppasswords). IMAP must be on.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SENDER_NAME=

# Telegram alerts: bot token from @BotFather; chat ID from getUpdates after you send the bot "hi".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ElevenLabs: voice notes + the Talk to Pitchwala voice agent (public agent ID).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Safety + app
DAILY_CAP=10
FOLLOW_UP_DAYS=3
APP_PASSCODE=
DATABASE_PATH=data/agent.db
